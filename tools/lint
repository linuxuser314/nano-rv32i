#!/bin/bash
set -e # Abort immediately if any individual command fails

# Verify NANO_ROOT is defined before proceeding
if [ -z "$NANO_ROOT" ]; then
    echo "❌ ERROR: \$NANO_ROOT environment variable is not set."
    exit 1
fi

FILELIST="$NANO_ROOT/filelist.f"

# 1. Extract include paths from filelist.f and convert '+incdir+path' to '-Ipath'
INC_FLAGS=$(grep '^+incdir+' "$FILELIST" | sed 's/^+incdir+/-I/' | tr '\n' ' ')

# 2. Clean up file list paths (ignoring comments, empty lines, and \r)
SV_FILES=$(grep -v '^\s*//' "$FILELIST" | grep -v '^+incdir+' | grep -v '^\s*$' | tr -d '\r' | tr '\n' ' ')

echo "=== Step 1: Linting Native SystemVerilog with Verilator ==="
# Verilator ingests the original un-flattened SystemVerilog code tracks.
# Omitting the '-Wno-fatal' flag ensures any warning forces a hard script termination.
verilator --lint-only -Wall --top-module soc_top $INC_FLAGS $SV_FILES

echo "=== Step 2: Running sv2v Parser Check ==="
cd "$NANO_ROOT"
# Run sv2v strictly to ensure the codebase resolves structural translation rules.
# Output is routed to /dev/null so it does not mix with native linter targets.
sv2v $INC_FLAGS $SV_FILES > /dev/null
echo "✓ sv2v source translation check passed."

echo "✅ LINT SUCCESS: Codebase passed all checks with zero warnings!"