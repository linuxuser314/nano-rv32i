#!/usr/bin/env python3
# tools/run-tests

import os
import sys
import glob
import time
import subprocess
from concurrent.futures import ProcessPoolExecutor, as_completed

# Inject the tools directory into Python's path so it can find your package
script_dir = os.path.dirname(os.path.abspath(__file__))
if script_dir not in sys.path:
    sys.path.insert(0, script_dir)

import riscv_eda_toolchain
from rich.console import Console
from rich.progress import Progress, SpinnerColumn, TextColumn, BarColumn, TaskProgressColumn, TimeElapsedColumn

console = Console()
NANO_ROOT = riscv_eda_toolchain.get_nano_root()

# Update this path if you kept it as build/obj_dir/Vsoc_top
SIM_BIN = os.path.join(NANO_ROOT, "build", "soc_executable") 

def format_log(stat, elapsed, proc, msg):
    """Generates the scannable [STAT][TIME][PROC] output format."""
    return f"[{stat:<4}][{elapsed:>5.1f}][{proc:<6}] {msg}"

def run_test_node(asm_file):
    """
    The worker function executed by the parallel processes.
    Compiles the assembly, runs the simulation, and returns the formatted result.
    """
    start_time = time.time()
    basename = os.path.splitext(os.path.basename(asm_file))[0]
    out_prefix = os.path.join(NANO_ROOT, "build", "tests", basename)
    
    # 1. Compile the test using the custom riscv-tests linkers
    success = riscv_eda_toolchain.compile_asm(
        src_file=asm_file, 
        target_path=out_prefix, 
        is_test_suite=True
    )
    
    if not success:
        elapsed = time.time() - start_time
        return format_log("FAIL", elapsed, "GCC", f"Compilation failed for {basename}.S")
        
    # 2. Run the Hardware Simulation
    text_hex = f"{out_prefix}.text.hex"
    data_hex = f"{out_prefix}.data.hex"
    
    cmd = [
        SIM_BIN,
        f"+BOOT_ROM={text_hex}",
        f"+SYS_RAM={data_hex}"
    ]
    
    # Run Verilator isolated (timeout prevents infinite loops from broken CPU logic)
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        elapsed = time.time() - start_time
        return format_log("FAIL", elapsed, "VRIBLE", f"Simulation TIMEOUT for {basename}")

    elapsed = time.time() - start_time
    
    # 3. Determine Pass/Fail Status
    # Note: riscv-tests usually print "OK" or exit with specific codes.
    # Adjust this logic based on what your testbench actually outputs.
    if res.returncode == 0: 
        return format_log("PASS", elapsed, "VRIBLE", f"{basename}")
    else:
        # Include the stdout so you can see why it failed!
        return format_log("FAIL", elapsed, "VRIBLE", f"{basename} -> {res.stdout.strip()}")

def main():
    # 1. Automatically ensure the hardware model is up to date!
    rtl_files = riscv_eda_toolchain.get_rtl_files()
    wrapper_cpp = os.path.join(NANO_ROOT, "sim", "main.cpp")
    
    console.print("[cyan]Checking hardware model dependencies...[/cyan]")
    hdl_success = riscv_eda_toolchain.compile_hdl(rtl_files, wrapper_cpp)
    
    if not hdl_success:
        console.print("[bold red]❌ Hardware simulation build failed! Aborting test suite.[/bold red]")
        sys.exit(1)

    # Search for the RISC-V UI (User Integer) tests...
    # Update this path if your tests are stored in a different subfolder
    test_dir = os.path.join(NANO_ROOT, "sim", "vendor", "riscv-tests", "rv32i-p-asm")
    test_files = glob.glob(os.path.join(test_dir, "*.S"))
    
    if not test_files:
        console.print(f"[bold yellow]⚠️ No test files found in {test_dir}[/bold yellow]")
        sys.exit(1)

    console.print(f"🚀 [bold cyan]Dispatching {len(test_files)} tests to parallel workers...[/bold cyan]\n")
    
    pass_count = 0
    fail_count = 0

    # Initialize the rich progress bar
    with Progress(
        SpinnerColumn(),
        TextColumn("[progress.description]{task.description}"),
        BarColumn(),
        TaskProgressColumn(),
        TimeElapsedColumn(),
        console=console,
    ) as progress:
        
        task = progress.add_task("[cyan]Running Test Suite...", total=len(test_files))
        
        # Fire up the multi-core engine
        with ProcessPoolExecutor() as executor:
            # Submit all files to the pool
            future_to_test = {executor.submit(run_test_node, f): f for f in test_files}
            
            # As each parallel worker finishes, process the result immediately
            for future in as_completed(future_to_test):
                result_log = future.result()
                
                if "[PASS]" in result_log:
                    pass_count += 1
                else:
                    fail_count += 1
                
                # rich allows us to print directly above the live progress bar safely!
                if "[FAIL]" in result_log:
                    progress.console.print(f"[bold red]{result_log}[/bold red]")
                else:
                    progress.console.print(f"[green]{result_log}[/green]")
                
                progress.advance(task)

    # Final summary output
    print("-" * 50)
    print(format_log("DONE", 0.0, "SYS", f"Test Suite Complete. PASS: {pass_count} | FAIL: {fail_count}"))

if __name__ == "__main__":
    main()