#!/usr/bin/bash

set -e

# Create directories safely (won't overwrite or fail if they exist)
mkdir -p $NANO_ROOT/logs
mkdir -p $NANO_ROOT/build

# 1. Define the file order explicitly
SV_FILES="$NANO_ROOT/rtl/interfaces/*.sv \
          $NANO_ROOT/rtl/utils/*.sv \
          $NANO_ROOT/rtl/rv32i_core/*.sv \
          $NANO_ROOT/rtl/peripherals/*.sv \
          $NANO_ROOT/rtl/SoC/*.sv"

echo "[****][****] Sv2v Transpilation"

# 2. sv2v completely flattens the interfaces and SV features into standard Verilog
sv2v $SV_FILES > $NANO_ROOT/build/flattened.v

echo "[****][****] Yosys Synthesis"

# 3. Yosys reads the flattened file and outputs to /build
# Note: I added your strict latch-catching flag here!
yosys -e ".*latch.*" -p "read_verilog $NANO_ROOT/build/flattened.v; synth_gowin -top soc_top -json $NANO_ROOT/build/core.json" &>> $NANO_ROOT/logs/yosys-log.txt

echo "[****][****] NextPNR Place-And-Route"

# 4. NextPNR reads from /build, writes to /build, and sends timing to /logs
nextpnr-himbaechel --json $NANO_ROOT/build/core.json \
                   --write $NANO_ROOT/build/routed.json \
                   --device GW2AR-LV18QN88C8/I7 \
                   --vopt family=GW2A-18C \
                   --vopt cst=$NANO_ROOT/nano20k.cst \
                   --report $NANO_ROOT/logs/timing_report.json &>> $NANO_ROOT/logs/nextpnr-log.txt

echo "[****][****] Bitstream Generation (Project Apicula / gowin_pack)"

# 5. gowin_pack reads from /build, but drops the final .fs file in root for easy flashing
gowin_pack -d GW2A-18C -o $NANO_ROOT/firmware.fs $NANO_ROOT/build/routed.json &>> $NANO_ROOT/logs/gowin-log.txt
