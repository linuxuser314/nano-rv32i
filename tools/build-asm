#!/bin/bash

# Exit immediately if any command fails
set -e

# --- 1. ARGUMENT PARSING ---
if [ -z "$1" ]; then
    echo "Usage: build-asm <path/to/file.S> [--riscv-test]"
    exit 1
fi

SRC_FILE="$1"
DIR=$(dirname "$SRC_FILE")
BASENAME=$(basename "$SRC_FILE" | sed 's/\.[sS]$//')

OBJ_FILE="$DIR/$BASENAME.o"
ELF_FILE="$DIR/$BASENAME.elf"
TEXT_HEX="$DIR/$BASENAME.text.hex"
DATA_HEX="$DIR/$BASENAME.data.hex"
DUMP_FILE="$DIR/$BASENAME.dump"

# --- 2. ENVIRONMENT SETUP ---
AS_FLAGS="-march=rv32i -mabi=ilp32 -c"
LD_FLAGS="-m elf32lriscv -Ttext 0x00000000"

if [[ "$2" == "-riscv-test" || "$2" == "--riscv-test" ]]; then
    TEST_ENV="$NANO_ROOT/sim/vendor/riscv-tests/custom_env"
    TEST_MACROS="$NANO_ROOT/sim/vendor/riscv-tests/isa/macros/scalar"
    AS_FLAGS="-march=rv32i -mabi=ilp32 -I$TEST_ENV -I$TEST_MACROS -c"
    LD_FLAGS="-m elf32lriscv -T $TEST_ENV/link.ld"
fi

# --- 3. BUILD PIPELINE ---
riscv64-unknown-elf-gcc $AS_FLAGS "$SRC_FILE" -o "$OBJ_FILE"
riscv64-unknown-elf-ld $LD_FLAGS "$OBJ_FILE" -o "$ELF_FILE"
riscv64-unknown-elf-objdump -d "$ELF_FILE" > "$DUMP_FILE"

# Extract Sections
riscv64-unknown-elf-objcopy -j .text -O verilog "$ELF_FILE" "$TEXT_HEX"
riscv64-unknown-elf-objcopy -j .data -j .sdata -O verilog "$ELF_FILE" "$DATA_HEX"

# --- 4. PYTHON HEX FORMATTER ---
python3 -c "
import sys, os

def format_hex(filepath):
    # If a section is empty, objcopy doesn't create the file. We make a dummy one.
    if not os.path.exists(filepath) or os.path.getsize(filepath) == 0:
        with open(filepath, 'w') as f:
            f.write('@00000000\n00000000\n')
        return

    with open(filepath, 'r') as f:
        data = f.read().split()
    
    bytes_only = [b for b in data if not b.startswith('@')]
    words = []
    for i in range(0, len(bytes_only), 4):
        if i+3 < len(bytes_only):
            words.append(bytes_only[i+3] + bytes_only[i+2] + bytes_only[i+1] + bytes_only[i])
            
    with open(filepath, 'w') as f:
        f.write('@00000000\n' + '\n'.join(words) + '\n')

format_hex('$TEXT_HEX')
format_hex('$DATA_HEX')
"

# --- 5. CLEANUP ---
rm -f "$OBJ_FILE" "$ELF_FILE"