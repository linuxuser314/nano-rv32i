#!/usr/bin/bash

# Exit immediately if a command exits with a non-zero status, and catch pipe failures
set -eo pipefail

echo -e "\n======================================="
echo "       NANO-RV32I SIMULATION BUILD       "
echo "======================================="

# --- 1. OPTIONAL SOFTWARE COMPILATION ---
# You mentioned running build-asm manually, so this is commented out.
# Uncomment these lines if you ever want the simulation to automatically 
# rebuild the hex files before running!
#
# echo "[1/4] Assembling firmware..."
# $NANO_ROOT/tools/build-asm
# ----------------------------------------

# --- 2. DEFINE FILES AND DIRECTORIES ---
echo "[2/4] Gathering SystemVerilog files..."

# Explicitly order files to ensure interfaces are parsed before modules that use them
SV_FILES="$NANO_ROOT/rtl/interfaces/*.sv \
          $NANO_ROOT/rtl/utils/*.sv \
          $NANO_ROOT/rtl/rv32i_core/*.sv \
          $NANO_ROOT/rtl/peripherals/*.sv \
          $NANO_ROOT/rtl/SoC/*.sv"

# --- 3. VERILATOR TRANSPILATION ---
echo "[3/4] Transpiling SystemVerilog to C++ with Verilator..."

# Added performance and optimization flags (-O3, --x-assign, --x-initial)
# to make the C++ simulation run as fast as natively possible.
verilator --cc --exe --trace-fst -Wall \
          -Wno-fatal \
          -O3 \
          --x-assign fast \
          --x-initial fast \
          $SV_FILES \
          $NANO_ROOT/sim/main.cpp \
          --top-module soc_top \
          --Mdir $NANO_ROOT/obj_dir

# --- 4. C++ COMPILATION ---
echo "[4/4] Compiling the Verilator C++ model..."

# Suppress the massive makefile output with > /dev/null so you only see errors
make -C $NANO_ROOT/obj_dir -j$(nproc) -f Vsoc_top.mk > /dev/null

# --- 5. EXECUTE SIMULATION ---
echo -e "\n======================================="
echo "          RUNNING SIMULATION             "
echo "======================================="

# Run the simulation executable
$NANO_ROOT/obj_dir/Vsoc_top

# Move the trace file to the root directory if the C++ executable dumped it in obj_dir
if [ -f "$NANO_ROOT/obj_dir/sim_trace.fst" ]; then
    mv $NANO_ROOT/obj_dir/sim_trace.fst $NANO_ROOT/sim_trace.fst
fi

echo -e "\nSimulation complete! Open 'sim_trace.fst' in GTKWave, WaveTrace, or Surfer."