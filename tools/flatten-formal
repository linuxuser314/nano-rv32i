#!/usr/bin/env bash
set -e # Abort immediately if any individual command fails

# Verify NANO_ROOT is defined before proceeding
if [ -z "$NANO_ROOT" ]; then
    echo "❌ ERROR: \$NANO_ROOT environment variable is not set."
    exit 1
fi

# Explicit path constants
OUTPUT_FILE="$NANO_ROOT/tests/riscv-formal/cores/nano-rv32i/flattened.v"
WRAPPER_FILE="$NANO_ROOT/rvfi_wrapper.sv"

echo "Flattening core RTL + RVFI wrapper via sv2v..."

# Change directory to ensure smooth path resolution
cd "$NANO_ROOT"

sv2v \
    -I"rtl/interfaces" \
    -I"rtl/rv32i_core" \
    -I"rtl/utils" \
    "rtl/interfaces/ram_bus_if.sv" \
    "rtl/utils/adder.sv" \
    "rtl/utils/byte_shift_left.sv" \
    "rtl/utils/byte_shift_right.sv" \
    "rtl/utils/mux2.sv" \
    "rtl/utils/mux8.sv" \
    "rtl/utils/dff_register.sv" \
    "rtl/utils/shifter.sv" \
    "rtl/utils/ram_single_port.sv" \
    "rtl/utils/ram_dual_port.sv" \
    "rtl/rv32i_core/address_check.sv" \
    "rtl/rv32i_core/ALU_comparator.sv" \
    "rtl/rv32i_core/decoder.sv" \
    "rtl/rv32i_core/imm_dec_ext.sv" \
    "rtl/rv32i_core/instruction_rom.sv" \
    "rtl/rv32i_core/mask.sv" \
    "rtl/rv32i_core/load.sv" \
    "rtl/rv32i_core/store.sv" \
    "rtl/rv32i_core/load_store_unit.sv" \
    "rtl/rv32i_core/PC_subsystem.sv" \
    "rtl/rv32i_core/register_file.sv" \
    "rtl/rv32i_core/fetch_unit.sv" \
    "rtl/rv32i_core/rv32i_core.sv" \
    "$WRAPPER_FILE" \
    > "$OUTPUT_FILE"

echo "✅ SUCCESS: Isolated formal target generated at ${OUTPUT_FILE}"