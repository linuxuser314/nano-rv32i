#!/bin/bash
set -e # Abort immediately if any individual command fails

# Verify NANO_ROOT is defined before proceeding
if [ -z "$NANO_ROOT" ]; then
    echo "❌ ERROR: \$NANO_ROOT environment variable is not set."
    exit 1
fi

# Define explicit path constants
FILELIST="$NANO_ROOT/filelist.f"
CST_FILE="$NANO_ROOT/nano20k.cst"
BITSTREAM_OUT="$NANO_ROOT/bitstream.fs"

DIR_SYNTH_BUILD="$NANO_ROOT/build/synth"
DIR_PNR_BUILD="$NANO_ROOT/build/pnr"
DIR_SYNTH_LOG="$NANO_ROOT/logs/synth"
DIR_PNR_LOG="$NANO_ROOT/logs/pnr"

V_SYNTH="$DIR_SYNTH_BUILD/synthesized_design.v"
JSON_SYNTH="$DIR_SYNTH_BUILD/core.json"
JSON_PNR="$DIR_PNR_BUILD/core.pnr.json"

LOG_YOSYS="$DIR_SYNTH_LOG/yosys.log"
LOG_PNR="$DIR_PNR_LOG/nextpnr.log"

# 1. Guarantee all output, logging, and target directory paths exist
mkdir -p "$DIR_SYNTH_BUILD" "$DIR_PNR_BUILD" "$DIR_SYNTH_LOG" "$DIR_PNR_LOG" "$NANO_ROOT/build/target"

# 2. Create dummy sim_payload.hex if it does not already exist
if [ ! -f "$NANO_ROOT/build/target/sim_payload.hex" ]; then
    echo "Creating default sim_payload.hex..."
    cat << 'EOF' > "$NANO_ROOT/build/target/sim_payload.hex"
@00000000
00000000
EOF
fi

# 3. Create comprehensive RV32I bootloader.hex if it does not already exist.
#This is dummy data designed to make sure that Yosys knows that the processor is actually doing something...
if [ ! -f "$NANO_ROOT/build/target/bootloader.hex" ]; then
    echo "Creating multi-instruction RV32I test bootloader.hex..."
    cat << 'EOF' > "$NANO_ROOT/build/target/bootloader.hex"
