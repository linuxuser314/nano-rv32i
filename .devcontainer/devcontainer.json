{
    "name": "RISC-V Hardware Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2.5.9": {}
    },
    "postCreateCommand": "bash /workspaces/nano-rv32i/tools/setup-basic",
    "customizations": {
        "vscode": {
            "extensions": [
                "surfer-project.surfer",
                "mshr-h.VerilogHDL",
                "yzhang.markdown-all-in-one",
                "shd101wyy.markdown-preview-enhanced",
                "zhwu95.riscv",
                "GitHub.vscode-github-actions",
                "ms-azuretools.vscode-containers"
            ]
        }
    },
    // Add this block to lock in your environment variables permanently!
    "containerEnv": {
        "NANO_ROOT": "/workspaces/nano-rv32i"
    }
}
