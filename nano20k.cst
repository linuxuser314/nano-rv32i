//System Clock
IO_LOC "clk_27MHz" 4;

//Reset and User Button
IO_LOC "button_1" 88;
IO_PORT "button_1" PULL_MODE=DOWN;
IO_LOC "button_2" 87;
IO_PORT "button_2" PULL_MODE=DOWN;

//LED strip output
IO_LOC "led_strip6[5]" 20;
IO_LOC "led_strip6[4]" 19;
IO_LOC "led_strip6[3]" 18;
IO_LOC "led_strip6[2]" 17;
IO_LOC "led_strip6[1]" 16;
IO_LOC "led_strip6[0]" 15;

//Uart RX/TX
IO_LOC "bl616_uart_tx" 69;
IO_LOC "bl616_uart_rx" 70;